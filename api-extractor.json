{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "mainEntryPointFilePath": "<projectFolder>/build/index.d.ts",
  "compiler": { "tsconfigFilePath": "<projectFolder>/tsconfig.json" },
  "apiReport": {
    "enabled": true,
    "reportFileName": "react-native-sdk-base.api.md",
    "reportFolder": "<projectFolder>/etc/",
    "reportTempFolder": "<projectFolder>/temp/"
  },
  "docModel": { "enabled": false },
  "dtsRollup": { "enabled": false },
  "tsdocMetadata": { "enabled": false },
  "messages": {
    "compilerMessageReporting": { "default": { "logLevel": "error" } },
    "extractorMessageReporting": {
      "default": { "logLevel": "error" },
      "ae-missing-release-tag": { "logLevel": "error", "addToApiReportFile": false },
      "ae-forgotten-export": { "logLevel": "error", "addToApiReportFile": false },
      "ae-undocumented": { "logLevel": "error", "addToApiReportFile": false }
    },
    "tsdocMessageReporting": { "default": { "logLevel": "error" } }
  }
}
