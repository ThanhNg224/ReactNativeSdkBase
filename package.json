{
  "name": "react-native-sdk-base",
  "version": "0.1.0",
  "description": "A template for building a React Native SDK in TypeScript with an Expo native module: instance-based client, injectable HTTP transport, typed errors, and safe structured operation observability.",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./testing": {
      "types": "./build/testing.d.ts",
      "default": "./build/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "ios",
    "android",
    "!android/build",
    "!android/src/test",
    "!android/src/androidTest",
    "!**/__tests__",
    "!**/__mocks__",
    "expo-module.config.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "node scripts/clean.cjs",
    "prepare": "node scripts/clean.cjs && tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "boundaries": "node scripts/check-boundaries.cjs",
    "example:verify": "npm --prefix example run typecheck && npm --prefix example test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run boundaries && npm run example:verify",
    "api": "npm run build && api-extractor run --local -c api-extractor.json && api-extractor run --local -c api-extractor.testing.json",
    "api:check": "api-extractor run -c api-extractor.json && api-extractor run -c api-extractor.testing.json",
    "docs": "typedoc",
    "package:check": "publint --strict && attw --pack . --profile esm-only && node scripts/check-pack.cjs",
    "ci": "npm run verify && npm run build && npm run api:check && npm run docs && npm run package:check && npm publish --dry-run --ignore-scripts",
    "packaged-example": "node scripts/packaged-example.cjs",
    "rename": "node scripts/rename.cjs",
    "open:ios": "node scripts/open-ios.cjs",
    "open:android": "node scripts/open-android.cjs"
  },
  "keywords": [
    "react-native",
    "expo",
    "sdk",
    "react-native-sdk-base"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThanhNg224/ReactNativeSdkBase.git"
  },
  "bugs": {
    "url": "https://github.com/ThanhNg224/ReactNativeSdkBase/issues"
  },
  "author": "ThanhNg224 (https://github.com/ThanhNg224)",
  "license": "MIT",
  "homepage": "https://github.com/ThanhNg224/ReactNativeSdkBase#readme",
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^8.0.6",
    "@microsoft/api-extractor": "^7.59.3",
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "^29.2.1",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.13",
    "eslint": "~10.11.0",
    "eslint-config-universe": "^16.0.0",
    "expo": "~57.0.26",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.0.0",
    "publint": "^0.3.25",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "expo": ">=57.0.0",
    "react": ">=19.2.0",
    "react-native": ">=0.86.0"
  }
}
