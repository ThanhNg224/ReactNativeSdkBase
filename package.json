{
  "name": "react-native-sdk-base",
  "version": "0.1.0",
  "description": "A template for building a React Native SDK in TypeScript with an Expo native module: instance-based client, injectable HTTP transport, typed errors, and safe structured operation observability.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./testing": {
      "types": "./build/testing.d.ts",
      "default": "./build/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "ios",
    "android",
    "!android/build",
    "!android/src/test",
    "!android/src/androidTest",
    "!**/__tests__",
    "!**/__mocks__",
    "expo-module.config.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "clean": "node scripts/clean.js",
    "lint": "eslint src/",
    "test": "node scripts/test.js",
    "prepare": "node scripts/prepare.js",
    "open:ios": "node scripts/open-ios.js",
    "open:android": "node scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "sdk",
    "react-native-sdk-base"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThanhNg224/ReactNativeSdkBase.git"
  },
  "bugs": {
    "url": "https://github.com/ThanhNg224/ReactNativeSdkBase/issues"
  },
  "author": "ThanhNg224 (https://github.com/ThanhNg224)",
  "license": "MIT",
  "homepage": "https://github.com/ThanhNg224/ReactNativeSdkBase#readme",
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.13",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "~57.0.26",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": ">=57.0.0",
    "react": ">=19.2.0",
    "react-native": ">=0.86.0"
  }
}
